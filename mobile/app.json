{
  "expo": {
    "name": "Mira",
    "slug": "mira-native-spike",
    "scheme": "mira",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/mira-launcher-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bitcode": false
    },
    "android": {
      "package": "com.sandi.mira",
      "versionCode": 2,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E7",
        "foregroundImage": "./assets/brand/mira-launcher-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Mira uses your microphone while you hold to speak in Talk or Brain Dump, and during a Call Mira call until you mute or hang up.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Mira uses your microphone while you hold to speak in Talk or Brain Dump, and during a Call Mira call until you mute or hang up."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mira-launcher-foreground.png",
          "imageWidth": 152,
          "resizeMode": "contain",
          "backgroundColor": "#F7F1E7",
          "dark": {
            "image": "./assets/brand/mira-launcher-foreground.png",
            "backgroundColor": "#17241D"
          }
        }
      ],
      "./plugins/withPrivateDemoHttp",
      "./plugins/withDeviceOnlyData",
      "./plugins/withMiraCalls",
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "apiUrl": "https://3.104.124.56",
      "eas": {
        "projectId": "a39636fc-d431-4128-9971-6fd271bf5cf6"
      }
    },
    "owner": "feat.sandip"
  }
}
