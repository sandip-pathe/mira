OPENAI_API_KEY=
BOLNA_API_KEY=
BOLNA_AGENT_ID=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Keep false for local development; set true on the reviewer backend.
MIRA_REVIEWER_ACCESS_REQUIRED=false
# Comma-separated Firebase UIDs, never emails or passwords.
MIRA_REVIEWER_UIDS=
# UTC expiry in YYYY-MM-DDTHH:MM:SSZ format.
MIRA_REVIEW_ACCESS_UNTIL=
MIRA_PAID_OPERATIONS_ENABLED=true
MIRA_OPENAI_REVIEW_BUDGET_USD=20
MIRA_OPENAI_OPERATIONS_PER_USER_PER_DAY=50
MIRA_BOLNA_CALLS_PER_USER_PER_DAY=3
MIRA_BOLNA_MINT_COOLDOWN_SECONDS=60
MIRA_BUDGET_DB_PATH=
